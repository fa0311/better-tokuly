# Tokuly deployment: secrets and how the deployment is reached, for `docker compose`.
#
# Do not copy this file by hand: `tools/init-env.sh` writes `.env` from it and
# fills in freshly generated secrets. Edit `.env` afterwards.
#
# Every other setting (registration, media limits, rate limits, mail sender,
# integrations ...) lives in config/tokuly.toml — see tokuly.example.toml for
# all of them — or in the staff console (「サーバー設定」). A TOKULY_* variable
# put here still reaches the backend and wins over both: that is the override
# for containers and CI. An empty `TOKULY_X=` counts as not set (the server
# says so when it starts), except where empty means something, such as
# TOKULY_TRUSTED_PROXIES= (no proxies) or TOKULY_WALLET_DAILY_BONUS_COINS= (no
# bonus): tokuly.example.toml says which.

# ── Which build ──────────────────────────────────────────────────────────────
# A released version (for example 0.1.0), or `edge`: the newest build of
# `main` that passed the end-to-end checks. Images are pulled from
# the GitHub Container Registry; `docker compose up -d --build` builds from
# this checkout instead.
TOKULY_VERSION=edge

# ── Where people reach it ────────────────────────────────────────────────────
# The address in the browser, without a trailing slash.
TOKULY_PUBLIC_URL=http://localhost
# How the edge listens: `:80` = plain HTTP on any name (right for localhost);
# a domain such as `tokuly.example.com` = automatic HTTPS and HTTP/3.
TOKULY_SITE_ADDRESS=:80
TOKULY_HTTP_PORT=80
TOKULY_HTTPS_PORT=443
# Browsers upload media straight to object storage and connect to LiveKit for
# calls. Both must be reachable from outside under these addresses.
TOKULY_S3_PUBLIC_ENDPOINT=http://localhost:9000
TOKULY_LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Live streams go through the media server (MediaMTX), which encoders and
# players reach directly: RTMP 1935, SRT 8890/udp, HLS 8888, WebRTC 8889 and
# 8189/udp, rewinding 9996. Put your host name in place of localhost.
TOKULY_LIVE_PUBLIC_HOST=localhost
TOKULY_LIVE_RTMP_URL=rtmp://localhost:1935
TOKULY_LIVE_SRT_URL=srt://localhost:8890
TOKULY_LIVE_WHIP_URL=http://localhost:8889
TOKULY_LIVE_WHEP_URL=http://localhost:8889
TOKULY_LIVE_HLS_URL=http://localhost:8888
TOKULY_LIVE_PLAYBACK_URL=http://localhost:9996

# ── The first admin ──────────────────────────────────────────────────────────
# E-mail address of your own account: that account becomes admin as soon as
# the address is verified (open the link mailed at sign-up), once per
# deployment. A handle is not accepted. Uncomment and fill in.
# TOKULY_ADMIN_USER=you@example.com

# ── Map ──────────────────────────────────────────────────────────────────────
# The area downloaded at street level on first start: min_lon,min_lat,max_lon,max_lat
# (default: greater Tokyo, about 300 MB). The whole world is always there at low zoom.
TOKULY_MAP_REGION_BBOX=139.2,35.2,140.3,36.0
TOKULY_MAP_REGION_MAXZOOM=15

# ── Mail server ──────────────────────────────────────────────────────────────
# Until this points at a real server, mail is caught by Mailpit (http://localhost:8025).
# Example: smtps://user:password@smtp.example.com:465
TOKULY_SMTP_URL=smtp://mailpit:1025

# ── Optional secrets (uncomment what you use) ────────────────────────────────
# Their non-secret companions (client IDs, models, ...) go in config/tokuly.toml.
# AI assist in chat: starting values, the console (/admin/chat-ai) can change them.
# TOKULY_ANTHROPIC_API_KEY=
# TOKULY_OPENAI_API_KEY=
# TOKULY_OPENAI_COMPAT_API_KEY=
# "Now playing" on profiles ([identity] spotify_client_id in tokuly.toml).
# TOKULY_SPOTIFY_CLIENT_SECRET=
# Push to the mobile apps (Web Push needs nothing; [notify] apns_* in tokuly.toml).
# TOKULY_FCM_SERVICE_ACCOUNT_JSON=
# TOKULY_APNS_KEY_P8=

# ── Operations ───────────────────────────────────────────────────────────────
# `observability` adds Grafana with traces, logs and metrics at http://localhost:3001;
# with it, also set TOKULY_OTLP_ENDPOINT=http://observability:4317.
COMPOSE_PROFILES=
# TOKULY_OTLP_ENDPOINT=

# ── Secrets (generated by tools/init-env.sh; keep them, losing TOKULY_SECRET signs everyone out) ──
# After an update that adds a secret here, run tools/init-env.sh again: it adds
# what your .env lacks and leaves the rest alone.
TOKULY_SECRET=
# Only while replacing TOKULY_SECRET: the old value (docs/configuration.md).
# TOKULY_SECRET_PREVIOUS=
POSTGRES_PASSWORD=
STORAGE_ACCESS_KEY=tokuly
STORAGE_SECRET_KEY=
CLICKHOUSE_PASSWORD=
MEILI_MASTER_KEY=
LIVEKIT_API_KEY=tokuly
LIVEKIT_API_SECRET=
# Live streams, two different secrets: what the media server presents to the
# API when it asks who may publish or watch, and what the worker presents to
# the media server's control API.
TOKULY_LIVE_HOOK_SECRET=
TOKULY_MEDIAMTX_API_SECRET=

# Optional: the demo simulator (bots that walk around the map, chat and post;
# Compose profile `demo`). tools/demo-env.sh turns it on: it puts `demo` into
# COMPOSE_PROFILES and adds these two with random values. See docs/demo.md.
# TOKULY_DEV_DEMO_OPERATORS=
# TOKULY_DEV_DEMO_PASSWORD=
