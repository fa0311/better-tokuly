# The edge: the one address browsers talk to. It speaks HTTP/1.1, HTTP/2 and
# (with HTTPS) HTTP/3, and hands each path to the service behind it.
#
# TOKULY_SITE_ADDRESS decides how it listens:
#   :80                  plain HTTP on every name (the default; right for http://localhost)
#   tokuly.example.com   automatic HTTPS for that domain, HTTP/3 included
#   https://localhost    HTTPS with a locally generated certificate (browsers will warn)

{$TOKULY_SITE_ADDRESS::80} {
	encode zstd gzip

	# For every answer of the edge. Nothing here is guessed from its bytes
	# (a file served with the wrong type must not run as a script), and
	# other sites learn the origin a link was followed from, never the
	# page: a path can name a person, a conversation or a place.
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	# Once reached over HTTPS, always over HTTPS (a year). Not sent over
	# plain HTTP, where browsers ignore it: http://localhost and a LAN
	# address keep working.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# Calls of our own infrastructure reach the API inside the stack
	# (http://api:8081), never through the edge: from outside, these routes
	# do not exist. LiveKit's webhook for audio rooms:
	handle /api/spaces/livekit/webhook {
		respond 404
	}
	# The media server's questions about live streams. `/hooks/*` is not
	# forwarded to the API today; it is refused here so it never will be.
	@hooks path /api/hooks /api/hooks/* /hooks /hooks/*
	handle @hooks {
		respond 404
	}

	# Connect RPC, gRPC and gRPC-Web. The API speaks cleartext HTTP/2, so
	# streaming calls pass through unbuffered.
	handle_path /api/* {
		reverse_proxy h2c://api:8081 {
			flush_interval -1
		}
	}

	# WebSocket fallback of the realtime gateway (WebTransport bypasses the edge).
	handle /rt/ws {
		reverse_proxy realtime:8082
	}

	# Public media: /media/<key> is the object <key> of the public bucket.
	#
	# Any of it can be removed (its owner deletes it, a moderator takes it
	# down) and must then stop being served at once. The object store answers
	# 404 as soon as the asset's objects are purged, right after the deletion
	# is committed; so no cache may answer without asking here first. Shared
	# caches (a CDN in front of this edge) revalidate every request
	# (s-maxage=0: an unchanged object costs a 304 and no body), browsers keep
	# a copy for five minutes. A CDN that caches longer must purge on
	# `media.asset.deleted`: docs/events/media.md, "Caches and CDNs". The
	# value is the media domain's `store::PUBLIC_CACHE` (a test keeps them
	# equal); it replaces whatever an object was stored with.
	handle_path /media/* {
		# The asset an object belongs to, for CDNs that purge by tag.
		@asset path_regexp asset ^/(?:img|anim|video|audio|file)/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/
		header @asset Cache-Tag "asset-{re.asset.1}"
		header @asset Surrogate-Key "asset-{re.asset.1}"
		# People's files, opened on their own (an SVG, a page), run nothing on
		# this origin. The app's pages get their policies from the web server.
		header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; style-src 'unsafe-inline'; sandbox"
		rewrite * /tokuly-media{uri}
		reverse_proxy storage:9000 {
			header_down Cache-Control "public, max-age=300, s-maxage=0, must-revalidate"
		}
	}

	# Vector map tiles, and the fonts and icons the map style refers to.
	handle_path /tiles/* {
		reverse_proxy tiles:8080
	}
	handle_path /map-assets/* {
		root * /srv/map-assets
		file_server
		header Cache-Control "public, max-age=604800"
	}

	# Everything else is the web app.
	handle {
		reverse_proxy web:3000
	}
}
