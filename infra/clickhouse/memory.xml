<!-- Sized for one small machine (docs/memory.md). ClickHouse reads its container's memory limit
     (mem_limit in compose.yaml) as the machine's RAM, so the ratio follows that limit. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>

    <!-- The defaults are sized for a dedicated server (5 GB each). -->
    <mark_cache_size>67108864</mark_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <primary_index_cache_size>33554432</primary_index_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <vector_similarity_index_cache_size>0</vector_similarity_index_cache_size>
    <text_index_postings_cache_size>33554432</text_index_postings_cache_size>
    <text_index_tokens_cache_size>16777216</text_index_tokens_cache_size>
    <text_index_header_cache_size>16777216</text_index_header_cache_size>
    <parquet_metadata_cache_size>16777216</parquet_metadata_cache_size>
    <paimon_metadata_files_cache_size>16777216</paimon_metadata_files_cache_size>

    <!-- ClickHouse's own diagnostics tables: they grow without anyone reading them. -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <latency_log remove="1"/>
    <query_metric_log remove="1"/>
    <error_log remove="1"/>
    <background_schedule_pool_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
</clickhouse>
