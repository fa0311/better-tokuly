{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/src/gen",
      "!**/routeTree.gen.ts",
      "!backend",
      "!**/src-tauri/gen",
      "!**/src-tauri/target",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "a11y": {
        "useMediaCaption": "off",
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["apps/web/src/**"],
      "plugins": ["./apps/web/lint/no-t-in-effect-deps.grit"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["lazy"],
                    "message": "A lazy component whose code fails to arrive takes the app to its error screen, and never loads again. Use `onDemand` from `#/components/on-demand`."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
