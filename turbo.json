{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "generate": {
      "inputs": ["$TURBO_ROOT$/proto/**", "$TURBO_ROOT$/buf.yaml", "buf.gen.yaml"],
      "outputs": ["src/gen/**"]
    },
    "build": {
      "dependsOn": ["^generate", "generate", "^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate", "^build"]
    },
    "test": {
      "dependsOn": ["^generate", "generate"]
    },
    "dev": {
      "dependsOn": ["^generate", "generate"],
      "cache": false,
      "persistent": true
    }
  }
}
